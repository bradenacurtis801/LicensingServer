# Copy this file to .env and fill in your values.

# Database
DATABASE_URL=
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DB_NAME=license_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application
APP_NAME=License Management System
APP_VERSION=1.0.0
DEBUG=false
BACKEND_PORT=8999

# Security
# Path to RSA private key PEM file for signing validation responses.
# Generate with:
#   openssl genrsa -out private.pem 2048
#
# When building a client SDK, also extract the public key to embed in it:
#   openssl rsa -in private.pem -pubout -out public.pem
RSA_PRIVATE_KEY_PATH=

# License key generation
LICENSE_KEY_LENGTH=25

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

